# Build output. The release APK is a ~53 MB binary that changes on every
# rebuild, so committing it means the repository grows by that much each time
# without any of it being source. Build it instead:
#     tools/build_release.sh --install
*.apk

# Antenna/range test logs produced by tools/log_dbm.py and the handheld's own
# walk-test dump. Newest-first timestamps make each run unique; they are data
# from a session, not source.
antenna-test-*.csv
walk-*.csv

# Python bytecode cache, regenerated every time a tool runs.
__pycache__/
*.pyc

# macOS
.DS_Store

# ESPHome build tree, generated inside homebase/esphome/ on every compile. ~22 MB
# of platformio artifacts, not source; `esphome compile` recreates it.
homebase/esphome/.esphome/
# arduino-cli writes an IDE-style build tree next to sketches that have a build.opts
# (the Arduino IDE opens these dirs). These are compiled artifacts of the sketch, so
# committing them grows the repo for no source. Rebuilding is one command — and each
# role build is pinned to its own --output-dir, see poc915/README.md.
poc915/build/
poc915/at_probe/build/
gateway/secrets.local
gateway/build/
